# Copy this file to .env.local (gitignored, never committed) and set your own
# ../server/ deploy's URL. Baked into the bundle at build time - one deployed
# client always talks to one server, so this is a deploy-time setting and not
# something a visitor types in.
#
#   cd client-react
#   copy .env.example .env.local      (Windows)
#   cp .env.example .env.local          (macOS/Linux)
#
# Then edit the copy - not this file. A build without it fails rather than
# producing a site that cannot reach an API; see vite.config.ts.
VITE_API_BASE=https://your-api-worker.your-subdomain.workers.dev
