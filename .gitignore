.DS_Store
Thumbs.db
*.tmp

# Personal data silo — never committed. See private.example/README.md.
/private/

# Wrangler local cache/build output, which can hold a cached
# wrangler-account.json. Unanchored so it catches any depth, not just the dirs
# that have a wrangler.toml today.
.wrangler/

# npm install output, if anyone runs it locally (server/package.json and
# client/package.json are mainly for the Deploy to Cloudflare button, which
# installs its own copy)
node_modules/
# The lockfile that install writes goes with it. client/ and server/ depend on
# little but wrangler, so a lockfile would pin every forker to whatever version
# was installed locally, and the Deploy button resolves its own copy regardless.
# Unanchored: it appears next to whichever package.json was installed.
package-lock.json
# ...except client-react/'s, which is committed: it has a real dependency tree,
# and unpinned that resolves differently on every machine and in CI.
!client-react/package-lock.json

# This installer's own API URL - treated like private/ data (see
# client/public/local-config.example.js). Never commit a real deployment's
# URL into the tracked template that other installers fork.
client/public/local-config.js

# Wrangler local dev secrets (ADMIN_TOKEN etc.) - never commit
server/.dev.vars
client/.dev.vars
