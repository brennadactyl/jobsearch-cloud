.DS_Store
Thumbs.db
*.tmp

# Personal data silo — never committed. See private.example/README.md.
/private/

# Wrangler local cache/build output, which can hold a cached
# wrangler-account.json. Unanchored so it catches any depth, not just the dirs
# that have a wrangler.toml today.
.wrangler/

# npm install output
node_modules/
# server/ depends on little but wrangler, so a lockfile would pin every forker
# to whatever version was installed locally, and the Deploy button resolves its
# own copy regardless. Unanchored: it appears next to whichever package.json was
# installed.
package-lock.json
# ...except client/'s, which is committed: it has a real dependency tree, and
# unpinned that resolves differently on every machine and in CI.
!client/package-lock.json

# This installer's own API URL is client/.env.local, ignored by client/.gitignore
# (see client/.env.example). Never commit a real deployment's URL into the
# template other installers fork.

# Wrangler local dev secrets (ADMIN_TOKEN etc.) - never commit
server/.dev.vars
client/.dev.vars
